# Banco local (docker compose). Na Vercel, a integração Supabase cria POSTGRES_URL e
# POSTGRES_URL_NON_POOLING, usadas automaticamente quando DATABASE_URL não existe.
DATABASE_URL=
AUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=
# Opcional: domínio próprio em produção (ex.: https://devshelf.com.br). Sem ele, usa o domínio da Vercel.
SITE_URL=
